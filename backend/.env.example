# Copy this file to ".env" (same folder) and fill in your own values. Never commit ".env".
PAYSTACK_SECRET_KEY=sk_test_your_key_here
# Your cut of every order, in percent. 0 means you keep nothing.
PLATFORM_FEE_PERCENT=0
# Who pays Paystack's processing fee: "subaccount" (the stall) or "account" (you)
PAYSTACK_BEARER=subaccount
# Optional: adds a friendly note to meal recommendations
# ANTHROPIC_API_KEY=

# Email (needed to really send verification codes and order updates). Leave EMAIL_HOST empty to just print emails in the terminal.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=FÜD <you@gmail.com>
